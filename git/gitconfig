[http]
	postBuffer = 524288000
	lowSpeedLimit = 1000
	version = HTTP/1.1
[user]
	name = SuchaharCan
	email = rocky.houjinsong@outlook.com
[core]
	editor = vim
	pager = less -FRSX
	fsmonitor = true
	untrackedcache = true
	symlinks = false
	fscache = true
	diff = auto
	status = auto
	branch = auto
	interactive = true
	ignorecase = true
	repositoryformatversion = 0
	filemode = true
	logallrefupdates = true
	pager = delta
	excludesfile = /Users/songhoujin/.gitignore
	compression = 0
	packedGitLimit = 5120000000000
	packedGitWindowSize = 5120000000
[fetch]
	prune = true
[alias]
	empty = git commit --allow-empty
	st = status
	com = commit
	p = pull
	c = clone --recursive
	pu = push
	ca = !git add -A && git commit -av
	co = checkout
	go = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"
	s = status -s
	tags = tag -l
	branches = branch -a
	remotes = remote -v
  l = log --graph --pretty=format:'%C(yellow)%h%C(auto)%d%Creset %s %C(white)- %an, %ar%Creset'
  clean = fetch --prune origin
	whoami = !git config --global user.name && git config --global user.email
[init]
	defaultBranch = main
[apply]
	whitespace = fix
[status]
	short = true
[color]
	ui = true
	branch = true
	diff = true
	interactive = true
	status = true
	grep = true
	pager = true
[color "status"]
	added = green
	changed = yellow
	untracked = red
[diff]
	tool = vimdiff
[commit]
	template = .commitMsg.txt
[push]
	default = current
	autoSetupRemote = true
[pack]
	window = 1
	depth = 1
	windowMemory = 204700000
	packSizeLimit = 204700000
	deltaCacheSize = 204700000
[index]
	threads = 0
[interactive]
	diffFilter = delta --color-only
