# 1. 在当前 Space 内切换窗口焦点 (alt + 方向键)
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# 2. 移动当前窗口位置（alt + shift + 方向键）
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# 3. 快速切换到指定的工作区 (alt + 数字键)
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4

# 4. 将当前窗口发送到指定的工作区 (alt + shift + 数字键)
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4

# 5. 动态创建/销毁工作区
alt - n : yabai -m space --create  # 创建一个新 Space
alt - x : yabai -m space --destroy # 销毁当前 Space

# 6. 切换当前工作区的布局模式 (平铺 <-> 浮动)
alt - f : yabai -m space --layout $(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "float" else "bsp" end')



# 当聚焦在 iTerm2 时，用 Alt + T 代替 Cmd + T 来新建标签页
alt - t : osascript -e 'tell application "iTerm2" to tell current window to create tab with default profile'

# ==========================================================================
# 模式一：平铺（BSP）模式下的“无脑丝滑微调” (类似 Linux TWM)
# 原理：利用 yabai 的向内/向外双向捕获，不管窗口在左边还是右边，朝哪个方向按就往哪个方向扩张
# ==========================================================================

# 向左扩张 (增加左边/减小右边)
ctrl + alt - h : yabai -m window --resize left:-20:0 2>/dev/null || yabai -m window --resize right:-20:0 2>/dev/null
# 向下扩张 (增加下边/减小上边)
ctrl + alt - j : yabai -m window --resize bottom:0:20 2>/dev/null || yabai -m window --resize top:0:20 2>/dev/null
# 向上扩张 (增加上边/减小下边)
ctrl + alt - k : yabai -m window --resize top:0:-20 2>/dev/null || yabai -m window --resize bottom:0:-20 2>/dev/null
# 向右扩张 (增加右边/减小左边)
ctrl + alt - l : yabai -m window --resize right:20:0 2>/dev/null || yabai -m window --resize left:20:0 2>/dev/null
