# =========================== 8. Vi 模式与光标控制 (已移除顶部的 bindkey -v 冲突项) ===========================
CURSOR_GOLD='\e]12;#D7AF00\a'
CURSOR_BAR='\e[5q'

function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]]; then
    echo -ne "\e[2q$CURSOR_GOLD"
  else
    echo -ne "$CURSOR_BAR$CURSOR_GOLD"
  fi
}
zle -N zle-keymap-select

precmd() { echo -ne "$CURSOR_BAR$CURSOR_GOLD" }
preexec() { echo -ne "$CURSOR_BAR$CURSOR_GOLD" }
echo -ne "$CURSOR_BAR$CURSOR_GOLD"

export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color=always $realpath'
zstyle ':completion:*:descriptions' format '[%d]'

# 允许 fzf-tab 使用连续补全的同时，不破坏上面的原生拦截规则
zstyle ':completion:*' menu no

zle_highlight+=(paste:none)

export ZSH_AUTOSUGGEST_STRATEGY=(history completion)






